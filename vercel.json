{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/latest.json.sig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pgp-signature"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}