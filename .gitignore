/.test/*.vdi
/.test/*.vmdk
/.test/*.log
/.test/*.json
!/.test/.gitkeep
core/camarelol-*.log
*.log

# ---------------------------------------------------------------- secrets
#
# Nothing below belongs in this repository. The signing key is a public key and
# is tracked; the private half lives in ~/.gnupg and never enters a tree.
#
# The OAuth client secret is the case that matters most here. A static site is
# served to everyone, so a secret in a tracked file — or in HTML, or in
# JavaScript — is a secret published. These patterns exist so that dropping a
# credential in the working tree does not also drop it in a commit.

# Environment files, in any form
.env
.env.*
!.env.example
*.env

# OAuth and provider credentials
code.json
client_secret*.json
credentials.json
*_secret.json
service-account*.json
*-credentials.json
*.oauth
gcloud*.json

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
*.pgp
*.asc

# Local deployment state, which carries deploy tokens

